# ---------------------------------------------------------------------------
# AI Tutor — local environment
# Copy to .env and adjust. Ports are deliberately non-default; see
# docs/architecture/08_Port_Allocation.md
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
WORKER_PORT=4002
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4001

# Docker Compose host-port mapping
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6380
S3_HOST_PORT=9010
S3_ADMIN_HOST_PORT=9011

# Postgres credentials (used by both Compose and the API)
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=aitutor
POSTGRES_DB=aitutor

DATABASE_URL=postgresql://aitutor:aitutor@localhost:5442/aitutor?schema=public
REDIS_URL=redis://localhost:6380

# Auth
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-staging
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-staging
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage (SeaweedFS S3 gateway locally; real S3-compatible storage deployed)
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=ai-tutor-local
S3_ACCESS_KEY=aitutor
S3_SECRET_KEY=aitutor123
S3_REGION=us-east-1

# AI — providers undecided (D-09/D-10/D-11), pending the Week 1 evaluation
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_CHAT=
LLM_MODEL_FAST=
VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Quotas
FREE_DAILY_QUESTIONS=10
FREE_DAILY_IMAGES=3
FREE_DAILY_QUIZZES=2
PREMIUM_DAILY_QUESTIONS=200
PREMIUM_DAILY_IMAGES=50

# Rate limiting (global, per IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# External — undecided (D-13, D-14)
SMS_PROVIDER=
SMS_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=debug
