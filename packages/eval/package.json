{
  "name": "@ai-tutor/eval",
  "version": "0.1.0",
  "private": true,
  "description": "AI provider evaluation harness \u2014 decides D-09, D-10 and D-11 by measurement.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-tutor-eval": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "eval": "tsx src/cli.ts",
    "eval:chat": "tsx src/cli.ts chat",
    "eval:vision": "tsx src/cli.ts vision",
    "eval:embedding": "tsx src/cli.ts embedding",
    "eval:sheet": "tsx src/cli.ts review-sheet",
    "eval:report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "@ai-tutor/shared-types": "workspace:*",
    "@anthropic-ai/sdk": "^0.129.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
