// AI Tutor Bangladesh — Prisma schema
//
// Scope of this first migration (doc 07, Weeks 1–2):
//   users, student_profiles, curricula, subjects, chapters, topics,
//   student_subjects, subscriptions, usage_records
//
// Deliberately NOT here yet — they arrive with the week that needs them:
//   knowledge_documents / knowledge_chunks  (Weeks 3–4, needs pgvector)
//   chat_sessions / chat_messages           (Weeks 5–6)
//   quizzes / quiz_*                        (Weeks 9–10)
//   topic_mastery / study_plans             (Weeks 11–12)
//   payments / ai_feedback                  (Weeks 13–14)

generator client {
  provider = "prisma-client-js"
  // pgvector needs the extension declared in the datasource, which is still
  // behind a preview flag. Required from Weeks 3–4 for knowledge_chunks.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ---------------------------------------------------------------------------
// Enums — mirrored in packages/shared-types/src/enums.ts. Keep them in step.
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Medium {
  BANGLA
  ENGLISH
  ENGLISH_VERSION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  FAMILY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentProvider {
  BKASH
  NAGAD
  SSLCOMMERZ
}

enum RequestType {
  CHAT
  IMAGE
  QUIZ_GEN
  EMBED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Refresh tokens live in Redis, not here (doc 07 Weeks 1–2, auth module).
model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  /// Primary identifier. Phone-first per D-12. E.164.
  phone        String     @unique @db.VarChar(20)
  /// Secondary, optional. Unique when present.
  email        String?    @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentProfile StudentProfile?
  usageRecords   UsageRecord[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model StudentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  /// 9 or 10 for the MVP (D-02).
  classLevel        Int      @map("class_level") @db.SmallInt
  curriculumId      String   @map("curriculum_id") @db.Uuid
  medium            Medium   @default(BANGLA)
  targetExam        String?  @map("target_exam") @db.VarChar(60)
  dailyGoalMinutes  Int      @default(30) @map("daily_goal_minutes")
  /// Preferred tutor language: bn | en | banglish.
  preferredLanguage String   @default("bn") @map("preferred_language") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum    Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  subjects      StudentSubject[]
  subscriptions Subscription[]

  @@index([curriculumId])
  @@index([classLevel])
  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Curriculum tree: Curriculum -> Subject -> Chapter -> Topic
// ---------------------------------------------------------------------------

model Curriculum {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable slug used in seeds and metadata filters, e.g. "nctb".
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  nameBn    String   @map("name_bn") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subjects Subject[]
  students StudentProfile[]

  @@map("curricula")
}

model Subject {
  id           String   @id @default(uuid()) @db.Uuid
  curriculumId String   @map("curriculum_id") @db.Uuid
  name         String   @db.VarChar(120)
  nameBn       String   @map("name_bn") @db.VarChar(120)
  /// e.g. "physics". Unique per curriculum + class.
  code         String   @db.VarChar(40)
  classLevel   Int      @map("class_level") @db.SmallInt
  /// Display order in the Learn tab.
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  curriculum      Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  studentSubjects StudentSubject[]

  @@unique([curriculumId, classLevel, code])
  @@index([classLevel, isActive])
  @@map("subjects")
}

model Chapter {
  id            String   @id @default(uuid()) @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  title         String   @db.VarChar(255)
  titleBn       String   @map("title_bn") @db.VarChar(255)
  chapterNumber Int      @map("chapter_number") @db.SmallInt
  description   String?  @db.Text
  descriptionBn String?  @map("description_bn") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([subjectId, chapterNumber])
  @@index([subjectId])
  @@map("chapters")
}

model Topic {
  id         String     @id @default(uuid()) @db.Uuid
  chapterId  String     @map("chapter_id") @db.Uuid
  title      String     @db.VarChar(255)
  titleBn    String     @map("title_bn") @db.VarChar(255)
  difficulty Difficulty @default(MEDIUM)
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("topics")
}

/// Which subjects a student picked during academic setup.
model StudentSubject {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@map("student_subjects")
}

// ---------------------------------------------------------------------------
// Commerce and cost — doc 07 §7.1, §7.3
// ---------------------------------------------------------------------------

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  studentId              String             @map("student_id") @db.Uuid
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  startedAt              DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Null for the perpetual FREE plan.
  expiresAt              DateTime?          @map("expires_at") @db.Timestamptz(6)
  paymentProvider        PaymentProvider?   @map("payment_provider")
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(255)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

/// One row per AI call. Backs quota enforcement and the cost model (arch §12,
/// doc 07 §10). Redis holds the hot counters; this is the durable ledger.
model UsageRecord {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  requestType   RequestType @map("request_type")
  model         String      @db.VarChar(120)
  inputTokens   Int         @default(0) @map("input_tokens")
  outputTokens  Int         @default(0) @map("output_tokens")
  /// USD, 6 decimal places — per-call costs are fractions of a cent.
  estimatedCost Decimal     @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  latencyMs     Int?        @map("latency_ms")
  /// Chat session this call belongs to. Untyped until Weeks 5–6 adds the table.
  sessionId     String?     @map("session_id") @db.Uuid
  requestId     String?     @map("request_id") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([requestType, createdAt])
  @@map("usage_records")
}
